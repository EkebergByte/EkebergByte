const t = translations[lang] || translations.no;
---

<BaseLayout title={t.title} description={t.desc} lang={lang} localizedUrls={localizedUrls}>
  <main class="bg-white text-slate-900 min-h-screen pt-20 pb-16 md:pt-32">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      
        <!-- Nagłówek strony prawnej -->
            <div class="text-left mb-12 border-b border-slate-100 pb-8">
                <!-- Zamieniono sztywny napis na dynamiczne tłumaczenie {t.jurisdiction} -->
                <span class="text-xs md:text-sm font-extrabold tracking-widest uppercase text-[#0A192F] bg-white border border-[#0A192F] px-4 py-1.5 rounded-full block w-fit mb-4">
                {t.jurisdiction}
                </span>
                <h1 class="text-3xl font-extrabold tracking-tight text-[#0A192F] sm:text-4xl leading-tight uppercase">
                {t.heading}
                </h1>
            </div>

      <!-- Treść polityki prywatności (Wysoki kontrast, doskonała czytelność i18n) -->
      <div class="space-y-10 text-slate-700 font-sans text-base sm:text-lg leading-relaxed">
        
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0A192F] uppercase tracking-wide">
            {t.sec1_title}
          </h2>
          <p class="font-medium text-slate-600">{t.sec1_p1}</p>
          <p class="font-medium text-slate-600">{t.sec1_p2}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0A192F] uppercase tracking-wide">
            {t.sec2_title}
          </h2>
          <p class="font-medium text-slate-600">{t.sec2_p1}</p>
          <p class="font-medium text-slate-600">{t.sec2_p2}</p>
          <p class="font-medium text-slate-600">{t.sec2_p3}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0A192F] uppercase tracking-wide">
            {t.sec3_title}
          </h2>
          <p class="font-medium text-slate-600">{t.sec3_p1}</p>
          <p class="font-medium text-slate-600">{t.sec3_p2}</p>
          <p class="font-medium text-slate-600">{t.sec3_p3}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0A192F] uppercase tracking-wide">
            {t.sec4_title}
          </h2>
          <p class="font-medium text-slate-600">{t.sec4_p1}</p>
          <p class="font-medium text-slate-600">{t.sec4_p2}</p>
          <p class="font-medium text-slate-600">{t.sec4_p3}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0A192F] uppercase tracking-wide">
            {t.sec5_title}
          </h2>
          <p class="font-medium text-slate-600">{t.sec5_p1}</p>
          <p class="font-medium text-slate-600">{t.sec5_p2}</p>
        </section>

        <section class="space-y-3">
