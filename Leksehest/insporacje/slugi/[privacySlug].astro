---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = false;
// Definiujemy unikalne, przetłumaczone slugi pod SEO dla każdego języka
export function getStaticPaths() {
  return [
    { params: { lang: "no", privacySlug: "personvern" } },
    { params: { lang: "pl", privacySlug: "polityka-prywatnosci" } },
    { params: { lang: "en", privacySlug: "privacy-policy" } },
    { params: { lang: "ua", privacySlug: "polityka-konfidentsiynosti" } }
  ];
}

const { lang, privacySlug } = Astro.params;

// Słownik localizedUrls rozwiązujący problem hreflang i przełącznika flag na podstronach prywatności
const localizedUrls = {
  no: "/no/personvern/",
  pl: "/pl/polityka-prywatnosci/",
  en: "/en/privacy-policy/",
  ua: "/ua/polityka-konfidentsiynosti/"
};

// Pełny, bezpieczny i profesjonalnie przetłumaczony słownik we wszystkich językach
const translations = {
  no: {
    title: "Personvernerklæring — Leksehest",
    desc: "Personvernerklæring for Leksehest. Les om hvordan vi samler inn, behandler og beskytter dine personopplysninger i samsvar med GDPR.",
    heading: "Personvernerklæring og databehandling",
    jurisdiction: "Jurisdiksjon: Norge",
    sec1_title: "§ 1. Generell informasjon",
    sec1_p1: "Denne personvernerklæringen redegjør for hvordan personopplysninger samles inn, behandles og beskyttes i forbindelse med private undervisningstjenester (privatundervisning og leksehjelp) levert personlig av en privatperson (heretter kalt Tjenesteyter eller Behandlingsansvarlig) som representerer nettstedet Leksehest.no i Norge.",
    sec1_p2: "Behandlingen av personopplysninger skjer i samsvar med EUs personvernforordning (GDPR) samt den norske personopplysningsloven.",
    
    sec2_title: "§ 2. Formål, omfang og rettslig grunnlag for behandlingen",
