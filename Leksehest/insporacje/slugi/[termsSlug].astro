---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = false;

export function getStaticPaths() {
  return [
    { params: { lang: "no", termsSlug: "vilkar" } },
    { params: { lang: "pl", termsSlug: "regulamin" } },
    { params: { lang: "en", termsSlug: "terms-and-conditions" } },
    { params: { lang: "ua", termsSlug: "umovy-vykorystannya" } }
  ];
}

const { lang, termsSlug } = Astro.params;


const localizedUrls = {
  no: "/no/vilkar/",
  pl: "/pl/regulamin/",
  en: "/en/terms-and-conditions/",
  ua: "/ua/umovy-vykorystannya/"
};

// Pełny, bezpieczny prawnie słownik regulaminu we wszystkich językach
const translations = {
  no: {
    title: "Vilkår og betingelser — Leksehest",
    desc: "Vilkår for private undervisningstjenester levert av Leksehest. Les om regler for bestilling, avbestilling og ansvarsbegrensning.",
    heading: "Vilkår for private undervisningstjenester",
    jurisdiction: "Jurisdiksjon: Norge",
    
    sec1_title: "§ 1. Juridisk status og generelle bestemmelser",
    sec1_p1: "Disse vilkårene gjelder for private utdanningstjenester (privatundervisning og leksehjelp) levert personlig av en privatperson (heretter kalt Tjenesteyter) til private kunder (heretter kalt Kunden eller Eleven) på tvers av Kongeriket Norge.",
    sec1_p2: "Tjenesteyter erklærer at tjenestene leveres som privat tjenesteyting av hobbykarakter (hobbyvirksomhet) og i samsvar med gjeldende skatteregler for skattefrie tjenester i private hjem (inntil 6 000 NOK per kalenderår per husstand, i henhold til Skatteetatens retningslinjer).",
    
    sec2_title: "§ 2. Tjenestens omfang og karakter (Innsatsforpliktelse)",
    sec2_p1: "Undervisningen omfatter utelukkende en innsatsforpliktelse (innsatsforpliktelse). Tjenesteyter forplikter seg til å utføre arbeidet med rimelig faglig nøyaktighet og tilrettelegge undervisningen best mulig etter Elevens behov.",
    sec2_p2: "Tjenestene er av rådgivende karakter. Tjenesteyter påtar seg ingen resultatforpliktelse (resultatforpliktelse). Tjenesteyter garanterer ikke spesifikke skolekarakterer, bestått eksamen, standpunktkarakter eller opptak til utdanningsinstitusjoner.",
    sec2_p3: "Elevens endelige faglige resultater avhenger av faktorer utenfor Tjenesteyters kontroll, herunder Elevens personlige forutsetninger, motivasjon, egeninnsats utenom timene, samt vurderingskriterier fastsatt av faglærer eller ekstern sensor (sensorordning).",
    
    sec3_title: "§ 3. Bestilling, betaling og mangel på handelsfaktura",
    sec3_p1: "Pris for tjenestene avtales skriftlig før undervisningen påbegynnes.",
    sec3_p2: "Betaling skjer umiddelbart etter hver undervisningstime, eller som forskuddsbetaling for en avtalt pakke med timer.",
    sec3_p3: "Vipps og direkte bankoverføring er de eneste godkjente betalingsmetodene.",
    sec3_p4: "Ettersom tjenesten er av ikke-kommersiell og privat karakter, utsteder ikke Tjenesteyter kommersielle MVA-fakturaer. På forespørsel kan det utstedes en privat kvittering for mottatt betaling (kvittering for privat tjenesteyting).",
    
    sec4_title: "§ 4. Avbestillingsregler (Avbestilling)",
    sec4_p1: "Bestilte undervisningstimer are bindende for begge parter.",
    sec4_p2: "Kunden har rett til gebyrfri avbestilling eller flytting av timer inntil 24 timer før avtalt oppstart.",
    sec4_p3: "Dersom Kunden avbestiller eller flytter timen mindre enn 24 timer før oppstart, eller hvis Eleven ikke møter til avtalt tid, belastes Kunden 100 % av avtalt pris som kompensasjon for reservert tid.",
    
    sec5_title: "§ 5. Ansvarsbegrensning",
    sec5_p1: "Tjenesteyters erstatningsansvar, uansett rettslig grunnlag, er begrenset oppad til det beløpet Kunden har betalt for den aktuelle enkelttimen tvisten gjelder.",
    sec5_p2: "Tjenesteyter er under ingen omstendigheter ansvarlig for indirekte tap, tapt fortjeneste, kostnader knyttet til forsinket skolegang, eksamensavgifter eller andre økonomiske eller ikke-økonomiske tap hos Kunden eller Eleven.",
    
    sec6_title: "§ 6. Lovvalg og tvisteløsning",
    sec6_p1: "Avtalen reguleres av lovgivningen i Kongeriket Norge.",
    sec6_p2: "Tvister som oppstår i forbindelse med tjenestene skal forsøkes løst i minnelighet. Dersom partene ikke kommer til enighet, skal saken bringes inn for det lokale Forliksrådet for megling.",
    sec6_p3: "Tjenesteyters verneting vedtas som eksklusivt verneting for eventuelle videre rettslige skritt."
  },
  pl: {
    title: "Regulamin — Leksehest",
    desc: "Warunki świadczenia prywatnych usług doradczo-edukacyjnych przez Leksehest. Przeczytaj o zasadach płatności, odwoływania zajęć i ograniczeniu odpowiedzialności.",
    heading: "Regulamin świadczenia prywatnych usług edukacyjnych",
    jurisdiction: "Jurysdykcja: Norwegia",
    sec1_title: "§ 1. Status prawny i postanowienia ogólne",
    sec1_p1: "Niniejszy regulamin określa warunki świadczenia prywatnych usług edukacyjnych (korepetycji) przez osobę fizyczną (zwaną dalej Korepetytorem) na rzecz osób prywatnych (zwanych dalej Zleceniodawcą lub Uczniem) na terytorium Królestwa Norwegii.",
    sec1_p2: "Korepetytor oświadcza, że świadczone usługi mają charakter prywatnej działalności usługowej o charakterze doradczo-edukacyjnym (privat tjenesteyting av hobbykarakter). Usługi są rozliczane zgodnie z norweskimi przepisami podatkowymi dotyczącymi limitów zwolnień dla osób fizycznych wykonujących drobne zlecenia prywatne (skattefrie tjenester i private hjem – inntil 6 000 NOK rocznie od jednego Zleceniodawcy).",
    
    sec2_title: "§ 2. Charakter usług i wyłączenie gwarancji rezultatów (Zasada starannego działania)",
    sec2_p1: "Przedmiotem umowy jest świadczenie usług drogą starannego działania (innsatsforpliktelse). Korepetytor zobowiązuje się do dołożenia należytej staranności w celu przekazania wiedzy i wyjaśnienia materiału dydaktycznego.",
    sec2_p2: "Usługa ma charakter doradczy. Korepetytor nie przyjmuje na siebie zobowiązania rezultatu (resultatforpliktelse). Korepetytor nie gwarantuje osiągnięcia przez Ucznia określonych ocen szkolnych, zdania egzaminów państwowych (np. standpunktkarakter, eksamen) ani dostania się do wybranych placówek.",
    sec2_p3: "Ostateczny wynik edukacyjny Ucznia zależy od czynników niezależnych od Korepetytora, w tym od indywidualnych predyspozycji Ucznia, jego zaangażowania, samodzielnej pracy poza godzinami zajęć oraz kryteriów oceny stosowanych przez zewnętrznych nauczycieli lub egzaminatorów państwowych (sensorordning).",
    
    sec3_title: "§ 3. Warunki rezerwacji, płatności i brak faktur handlowych",
    sec3_p1: "Cennik usług jest ustalany ze Zleceniodawcą przed rozpoczęciem zajęć.",
    sec3_p2: "Rozliczenie za zajęcia następuje bezpośrednio po każdej lekcji lub w formie przedpłaty za uzgodniony pakiet godzin.",
    sec3_p3: "Jedynymi akceptowanymi formami płatności są bezpośredni przelew bankowy na konto Korepetytora lub płatność przez system Vipps.",
    sec3_p4: "Z uwagi na niekomercyjny, prywatny charakter działalności, Korepetytor nie wystawia komercyjnych faktur VAT/MVA. Na życzenie Zleceniodawcy Korepetytor może wystawić prywatne potwierdzenie płatności (kvittering for privat tjenesteyting).",
    
    sec4_title: "§ 4. Polityka odwoływania zajęć (Avbestilling)",
    sec4_p1: "Rezerwacja terminu zajęć jest wiążąca dla obu stron.",
    sec4_p2: "Zleceniodawca ma prawo do bezpłatnego odwołania lub przełożenia zajęć najpóźniej na 24 godziny przed ich planowanym rozpoczęciem.",
    sec4_p3: "W przypadku odwołania zajęć przez Zleceniodawcę w czasie krótszym niż 24 godziny, lub w przypadku nieobecności Ucznia, Zleceniodawca jest zobowiązany do pokrycia 100% ceny umówionej lekcji jako rekompensaty za zarezerwowany czas.",
    
    sec5_title: "§ 5. Ograniczenie odpowiedzialności cywilnej (Ansvarsbegrensning)",
    sec5_p1: "Odpowiedzialność odszkodowawcza Korepetytora z jakiegokolwiek tytułu jest ograniczona wyłącznie do wysokości opłaty uiszczonej przez Zleceniodawcę za lekcję, której dotyczy spór.",
    sec5_p2: "Korepetytor nie ponosi odpowiedzialności za jakiekolwiek szkody pośrednie, utracone korzyści, koszty powtórzenia roku, opłaty za niezaliczone egzaminy ani inne straty materialne lub niematerialne poniesione przez Ucznia lub Zleceniodawcę.",
    
    sec6_title: "§ 6. Prawo właściwe, jurysdykcja i rozwiązywanie sporów",
    sec6_p1: "Wszelkie spory wynikające z realizacji usług będą rozstrzygane zgodnie z prawem Królestwa Norwegii.",
    sec6_p2: "Wszelkie spory, których nie uda się rozwiązać polubownie, muszą być w pierwszej kolejności skierowane do właściwego miejscowo norweskiego organu mediacyjnego – Rady Polubownej (Forliksrådet).",
    sec6_p3: "Sądem właściwym dla rozstrzygania ewentualnych dalszych sporów jest sąd powszechny właściwy dla miejsca zamieszkania Korepetytora w Norwegii."
  },
  en: {
    title: "Terms and Conditions — Leksehest",
    desc: "Terms of service for private tutoring provided by Leksehest. Learn about rules for booking, cancellation policy, and limitation of liability.",
    heading: "Terms of service for private tutoring",
    jurisdiction: "Jurisdiction: Norway",
    sec1_title: "§ 1. Legal Status and General Provisions",
    sec1_p1: "These terms and conditions govern the private educational services (private tutoring and homework assistance) provided personally by an individual (hereinafter referred to as the Tutor) to private customers (hereinafter referred to as the Customer or Student) across the Kingdom of Norway.",
    sec1_p2: "The Tutor declares that the services are provided as private services of a hobby nature (hobbyvirksomhet) and in compliance with the applicable tax rules for tax-free services in private homes (up to NOK 6,000 per calendar year per household, in accordance with Skatteetaten's guidelines).",
    
    sec2_title: "§ 2. Nature of Services and Disclaimer of Results (Duty of Care)",
    sec2_p1: "The contract is solely for services of best effort (innsatsforpliktelse). The Tutor undertakes to perform the work with reasonable professional care and to tailor the tutoring to the Student's needs.",
    sec2_p2: "The services are of an advisory nature. The Tutor does not assume any obligation of result (resultatforpliktelse). The Tutor does not guarantee specific school grades, passing exams, standpunktkarakter, or admission to educational institutions.",
    sec2_p3: "The Student's final educational results depend on factors beyond the Tutor's control, including the Student's personal abilities, motivation, self-study outside of classes, as well as assessment criteria established by teachers or external graders (sensorordning).",
    
    sec3_title: "§ 3. Booking, Payments, and Absence of Commercial Invoices",
    sec3_p1: "The pricing for the services is agreed upon in writing before the tutoring begins.",
    sec3_p2: "Payment is due immediately after each tutoring session, or as a prepayment for an agreed package of hours.",
    sec3_p3: "Vipps and direct bank transfer are the only approved payment methods.",
    sec3_p4: "Since the service is of a non-commercial and private nature, the Tutor does not issue commercial VAT/MVA invoices. Upon request, a private receipt for payment received (kvittering for privat tjenesteyting) can be issued.",
    
    sec4_title: "§ 4. Cancellation Policy (Avbestilling)",
    sec4_p1: "Booked tutoring sessions are binding on both parties.",
    sec4_p2: "The Customer has the right to free cancellation or rescheduling of sessions up to 24 hours before the scheduled start.",
    sec4_p3: "If the Customer cancels or reschedules the session less than 24 hours before the start, or if the Student fails to appear, the Customer will be charged 100% of the agreed price as compensation for the reserved time.",
    
    sec5_title: "§ 5. Limitation of Liability",
    sec5_p1: "The Tutor's liability for damages, on whatever legal grounds, is limited to the amount paid by the Customer for the specific individual lesson to which the dispute relates.",
    sec5_p2: "Under no circumstances shall the Tutor be liable for indirect losses, lost profits, costs associated with delayed schooling, exam fees, or other financial or non-financial losses incurred by the Customer or Student.",
    
    sec6_title: "§ 6. Dispute Resolution and Governing Law",
    sec6_p1: "This agreement is governed by the laws of the Kingdom of Norway.",
    sec6_p2: "Disputes arising in connection with the services shall first be attempted to be resolved amicably. If the parties do not reach an agreement, the matter must be brought before the local Conciliation Board (Forliksrådet) for mediation.",
    sec6_p3: "The Tutor's home court is adopted as the exclusive jurisdiction for any further legal proceedings."
  },
  ua: {
    title: "Правила та умови — Leksehest",
    desc: "Умови надання приватних освітніх послуг від Leksehest. Дізнайтеся про правила бронювання, скасування занять та обмеження відповідальності.",
    heading: "Умови надання приватних репетиторських послуг",
    jurisdiction: "Юрисдикція: Норвегія",
    sec1_title: "§ 1. Юридичний статус та загальні положення",
    sec1_p1: "Ці правила та умови регулюють надання приватних освітніх послуг (індивідуальних занять та допомоги з домашніми завданнями), що надаються особисто фізичною особою (надалі — Репетитор) приватним клієнтам (надалі — Клієнт або Учень) на території Королівства Норвегія.",
    sec1_p2: "Репетитор декларує, що послуги надаються як приватна діяльність на аматорських засадах (hobbyvirksomhet) та відповідно до чинних податкових правил для неоподатковуваної праці в приватних будинках (до 6 000 норвезьких крон на календарний рік на одне домогосподарство, відповідно до інструкцій Skatteetaten).",
    
    sec2_title: "§ 2. Характер послуг та відсутність гарантії результатів (Зобов'язання докладати зусиль)",
    sec2_p1: "Предметом договору є виключно надання послуг шляхом докладання максимальних зусиль (innsatsforpliktelse). Репетитор зобов'язується виконувати роботу з належною професійною ретельністю та адаптувати заняття під потреби Учня.",
    sec2_p2: "Послуги мають консультативний характер. Репетитор не бере на себе зобов'язання щодо конкретного результату (resultatforpliktelse). Репетитор не гарантує отримання Учнем певних оцінок, складання державних іспитів (наприклад, standpunktkarakter, іспитів) чи вступу до обраних навчальних закладів.",
    sec2_p3: "Кінцевий успіх Учня залежатиме від факторів, які перебувають поза контролем Репетитора, включаючи індивідуальні здібності Учня, його мотивацію, самостійну роботу поза годинами занять, а також критерії оцінювання, встановлені вчителями або державними екзаменаторами (sensorordning).",
    
    sec3_title: "§ 3. Умови бронювання, оплати та відсутність комерційних рахунків-фактур",
    sec3_p1: "Вартість послуг узгоджується із Клієнтом у письмовій формі перед початком занять.",
    sec3_p2: "Оплата здійснюється безпосередньо після кожного уроку або у формі передоплати за узгоджений пакет годин.",
    sec3_p3: "Vipps та прямий банківський переказ на рахунок Репетитора є єдиними схваленими способами оплати.",
    sec3_p4: "Оскільки діяльність є некомерційною та приватною, Репетитор не виставляє комерційні рахунки-фактури ПДВ (MVA-faktura). На вимогу Клієнта може бути видана приватна квитанція про отримання оплати (kvittering for privat tjenesteyting).",
    
    sec4_title: "§ 4. Правила скасування занять (Avbestilling)",
    sec4_p1: "Заброньований час занять є обов'язковим для обох сторін.",
    sec4_p2: "Клієнт має право на безкоштовне скасування або перенесення занять не пізніше ніж за 24 години до запланованого початку.",
    sec4_p3: "У разі скасування або перенесення занять Клієнтом менш ніж за 24 години, або в разі відсутності Учня без попередження, Клієнт зобов'язаний сплатити 100% вартості узгодженого уроку як компенсацію за зарезервований час.",
    
    sec5_title: "§ 5. Обмеження відповідальності",
    sec5_p1: "Відповідальність Репетитора за відшкодування збитків, незалежно від юридичних підстав, обмежується виключно сумою, сплаченою Клієнтом за конкретний урок, якого стосується спір.",
    sec5_p2: "Репетитор за жодних обставин не несе відповідальності за будь-які непрямі збитки, втрачену вигоду, витрати, пов'язані з повторним роком навчання, оплату за нескладені іспити або інші фінансові чи нефінансові втрати, понесені Клієнтом чи Учнем.",
    
    sec6_title: "§ 6. Застосовне право та вирішення спорів",
    sec6_p1: "Ця угода регулюється законодавством Королівства Норвегія.",
    sec6_p2: "Будь-які спори, що виникають у зв'язку з наданням послуг, спочатку вирішуються шляхом мирних переговорів. Якщо сторони не дійшли згоди, справа має бути передана на розгляд до місцевої Примирливої ради (Forliksrådet) для медіації.",
    sec6_p3: "Місце проживання Репетитора приймається як виключна юрисдикція для будь-яких подальших судових розглядів."
  }
};

// Naprawiono logiczny błąd pobierania języka (pobieramy bezpośrednio ze słownika translations[lang])
const t = translations[lang] || translations.no;
---

<BaseLayout title={t.title} description={t.desc} lang={lang} localizedUrls={localizedUrls}>
  <main class="bg-white text-slate-900 min-h-screen pt-20 pb-16 md:pt-32">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      
    <!-- Nagłówek strony prawnej -->
        <div class="text-left mb-12 border-b border-slate-100 pb-8">
            <!-- Zamieniono sztywny napis na dynamiczne tłumaczenie {t.jurisdiction} -->
            <span class="text-xs md:text-sm font-extrabold tracking-widest uppercase text-[#0A192F] bg-white border border-[#0A192F] px-4 py-1.5 rounded-full block w-fit mb-4">
            {t.jurisdiction}
            </span>
            <h1 class="text-3xl font-extrabold tracking-tight text-[#0A192F] sm:text-4xl leading-tight uppercase">
            {t.heading}
            </h1>
        </div>

      <!-- Treść regulaminu (Wysoki kontrast, doskonała czytelność i18n) -->
      <div class="space-y-10 text-slate-700 font-sans text-base sm:text-lg leading-relaxed">
        
        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0A192F] uppercase tracking-wide">
            {t.sec1_title}
          </h2>
          <p class="font-medium text-slate-600">{t.sec1_p1}</p>
          <p class="font-medium text-slate-600">{t.sec1_p2}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0A192F] uppercase tracking-wide">
            {t.sec2_title}
          </h2>
          <p class="font-medium text-slate-600">{t.sec2_p1}</p>
          <p class="font-medium text-slate-600">{t.sec2_p2}</p>
          <p class="font-medium text-slate-600">{t.sec2_p3}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0A192F] uppercase tracking-wide">
            {t.sec3_title}
          </h2>
          <p class="font-medium text-slate-600">{t.sec3_p1}</p>
          <p class="font-medium text-slate-600">{t.sec3_p2}</p>
          <p class="font-medium text-slate-600">{t.sec3_p3}</p>
          <p class="font-medium text-slate-600">{t.sec3_p4}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0A192F] uppercase tracking-wide">
            {t.sec4_title}
          </h2>
          <p class="font-medium text-slate-600">{t.sec4_p1}</p>
          <p class="font-medium text-slate-600">{t.sec4_p2}</p>
          <p class="font-medium text-slate-600">{t.sec4_p3}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0A192F] uppercase tracking-wide">
            {t.sec5_title}
          </h2>
          <p class="font-medium text-slate-600">{t.sec5_p1}</p>
          <p class="font-medium text-slate-600">{t.sec5_p2}</p>
        </section>

        <section class="space-y-3">
          <h2 class="text-lg sm:text-xl font-extrabold text-[#0A192F] uppercase tracking-wide">
