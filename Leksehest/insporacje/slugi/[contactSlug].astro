---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = false;
export function getStaticPaths() {
  return [
    { params: { lang: "no", contactSlug: "kontakt" } },
    { params: { lang: "pl", contactSlug: "kontakt" } },
    { params: { lang: "en", contactSlug: "contact" } },
    { params: { lang: "ua", contactSlug: "kontakt" } },
  ];
}

const { lang } = Astro.params;

// Słownik zlokalizowanych adresów URL dla poprawnego działania hreflang
const localizedUrls = {
  no: "/no/kontakt/",
  pl: "/pl/kontakt/",
  en: "/en/contact/",
  ua: "/ua/kontakt/"
};

const translations = {
  no: {
    title: "Kontakt — Leksehest",
    badge: "Ta kontakt",
    heading: "La oss finne den beste løsningen sammen",
    desc: "Send meg en melding via skjemaet under, så svarer jeg deg så raskt som mulig.",
    labelName: "Navn",
    placeholderName: "Ditt fulle navn",
    labelEmail: "E-postadresse",
    placeholderEmail: "navn@eksempel.no",
    labelSubject: "Hva gjelder det?",
    placeholderSubject: "F.eks. Privatundervisning i matematikk",
    labelMessage: "Melding",
    placeholderMessage: "Skriv meldingen din her (minimum 30 tegn)...",
    buttonSubmit: "Send melding",
    buttonSending: "Sender...",
    successTitle: "Meldingen din er sendt!",
    successDesc: "Takk for at du tok kontakt. Jeg vil svare deg så raskt som overhodet mulig.",
    backBtn: "Gå tilbake til forsiden"
  },
  pl: {
    title: "Kontakt — Leksehest",
    badge: "Skontaktuj się",
    heading: "Znajdźmy razem najlepsze rozwiązanie",
    desc: "Wyślij mi wiadomość za pomocą poniższego formularza, a odpowiem tak szybko, jak to możliwe.",
    labelName: "Imię i nazwisko",
    placeholderName: "Twoje pełne imię i nazwisko",
    labelEmail: "Adres e-mail",
    placeholderEmail: "nazwisko@przyklad.pl",
    labelSubject: "Czego dotyczy sprawa?",
    placeholderSubject: "Np. Korepetycje z matematyki",
    labelMessage: "Wiadomość",
    placeholderMessage: "Wpisz swoją wiadomość tutaj (minimum 30 znaków)...",
    buttonSubmit: "Wyślij wiadomość",
    buttonSending: "Wysyłanie...",
    successTitle: "Wiadomość została wysłana!",
    successDesc: "Dziękuję za kontakt. Odpowiem na Twoją wiadomość tak szybko, jak to tylko możliwe.",
    backBtn: "Wróć do strony głównej"
  },
  en: {
    title: "Contact — Leksehest",
    badge: "Get in touch",
    heading: "Let's find the best solution together",
    desc: "Send me a message using the form below, and I will get back to you as soon as possible.",
    labelName: "Full Name",
    placeholderName: "Your full name",
    labelEmail: "E-mail Address",
    placeholderEmail: "name@example.com",
    labelSubject: "Subject",
    placeholderSubject: "e.g., Private tutoring in mathematics",
    labelMessage: "Message",
    placeholderMessage: "Write your message here (minimum 30 characters)...",
    buttonSubmit: "Send message",
    buttonSending: "Sending...",
    successTitle: "Your message has been sent!",
    successDesc: "Thank you for getting in touch. I will reply to you as quickly as possible.",
    backBtn: "Go back to homepage"
  },
  ua: {
    title: "Контакт — Leksehest",
    badge: "Зв'язатися",
    heading: "Давайте знайдемо найкраще рішення разом",
    desc: "Надішліть мені повідомлення за допомогою форми нижче, і я відповім вам якомога швидше.",
    labelName: "Ім'я та Прізвище",
    placeholderName: "Ваше повне ім'я та прізвище",
    labelEmail: "Електронна пошта",
    placeholderEmail: "name@example.ua",
    labelSubject: "Тема звернення",
    placeholderSubject: "Наприклад, Індивідуальні заняття з математики",
    labelMessage: "Повідомлення",
    placeholderMessage: "Напишіть ваше повідомлення тут (мінімум 30 символів)...",
    buttonSubmit: "Надіслати повідомлення",
    buttonSending: "Надсилання...",
    successTitle: "Ваше повідомлення надіслано!",
    successDesc: "Дякую за звернення. Я відповім вам якнайшвидше.",
    backBtn: "Повернутися на головну"
  }
};

const t = translations[lang] || translations.no;
---

<BaseLayout title={t.title} description={t.desc} lang={lang} localizedUrls={localizedUrls}>
  <main class="bg-white text-slate-900 min-h-screen pt-20 pb-16 md:pt-32">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-base md:text-lg font-bold tracking-wide uppercase text-[#173460] mb-3 block">
          {t.badge}
        </span>
        <h1 class="text-3xl font-extrabold tracking-tight text-[#173460] sm:text-4xl leading-tight uppercase">
          {t.heading}
        </h1>
        <p class="mt-4 text-base text-slate-600 leading-relaxed">
          {t.desc}
        </p>
      </div>

      <div class="relative bg-white border border-slate-100 rounded-[32px] p-6 sm:p-10 shadow-2xl overflow-hidden">
        
        <div class="absolute w-14 h-14 sm:w-20 sm:h-20 bg-[#fd6847] -top-4 -right-4 rounded-bl-[24px] sm:rounded-bl-[32px] z-20 pointer-events-none"></div>
        <div class="absolute w-14 h-14 sm:w-20 sm:h-20 bg-[#12ba87] -bottom-4 -left-4 rounded-tr-[24px] sm:rounded-tr-[32px] z-20 pointer-events-none"></div>

        <div id="form-container" class="relative z-10">
          <form id="contact-form" method="POST" class="space-y-6">
            
            <input type="hidden" name="access_key" value="1f442acb-9a3d-4cbb-a7f3-c0db50c08bc1" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" />
            
            <div>
              <label for="name" class="block text-sm font-semibold text-[#173460] mb-2 uppercase tracking-wide">
                {t.labelName}
              </label>
              <input 
                type="text" 
                name="name" 
                id="name" 
                required 
                placeholder={t.placeholderName} 
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#12ba87] focus:border-transparent text-slate-800 transition-all placeholder:text-slate-400 text-base"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-semibold text-[#173460] mb-2 uppercase tracking-wide">
                {t.labelEmail}
              </label>
              <input 
                type="email" 
                name="email" 
                id="email" 
                required 
                placeholder={t.placeholderEmail} 
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#12ba87] focus:border-transparent text-slate-800 transition-all placeholder:text-slate-400 text-base"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-semibold text-[#173460] mb-2 uppercase tracking-wide">
                {t.labelSubject}
              </label>
              <input 
                type="text" 
                name="subject" 
                id="subject" 
                required 
                placeholder={t.placeholderSubject} 
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#12ba87] focus:border-transparent text-slate-800 transition-all placeholder:text-slate-400 text-base"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-semibold text-[#173460] mb-2 uppercase tracking-wide">
                {t.labelMessage}
              </label>
              <textarea 
                name="message" 
                id="message" 
                rows="5" 
                required 
                minlength="30"
                maxlength="1000"
                placeholder={t.placeholderMessage} 
                class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-[#12ba87] focus:border-transparent text-slate-800 transition-all placeholder:text-slate-400 text-base resize-none"
              ></textarea>
            </div>

            <div class="pt-2 px-2 sm:px-0">
              <button 
                type="submit" 
                id="submit-btn"
                class="w-full bg-[#173460] hover:bg-[#1f427a] text-white font-extrabold px-4 py-4 sm:px-8 rounded-xl transition-all duration-200 shadow-lg text-sm sm:text-base tracking-widest uppercase"
              >
                <span id="btn-text">{t.buttonSubmit}</span>
              </button>
            </div>

          </form>
        </div>

        <div id="success-container" class="hidden relative z-10 text-center py-12 space-y-6">
          <div class="w-16 h-16 bg-[#12ba87]/10 text-[#12ba87] rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <h2 class="text-2xl font-extrabold text-[#173460] tracking-tight uppercase">
            {t.successTitle}
          </h2>
          <p class="text-base text-slate-600 max-w-sm mx-auto leading-relaxed">
            {t.successDesc}
          </p>
          <div class="pt-4">
            <a 
              href={`/${lang}/`} 
              class="inline-block bg-[#173460] hover:bg-[#1f427a] text-white font-extrabold px-8 py-4 rounded-xl transition-all duration-200 shadow-lg text-base tracking-wide uppercase"
            >
              {t.backBtn}
            </a>
          </div>
        </div>

      </div>

    </div>
  </main>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const formContainer = document.getElementById('form-container');
  const successContainer = document.getElementById('success-container');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');

  if (form && formContainer && successContainer && submitBtn && btnText) {
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const loadingText = langTextMap[document.documentElement.lang] || 'Sender...';
      btnText.textContent = loadingText;
      submitBtn.disabled = true;

      const formData = new FormData(form);
      const object = Object.fromEntries(formData);
      const json = JSON.stringify(object);

      fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: json
      })
      .then(async (response) => {
        if (response.status === 200) {
          formContainer.classList.add('hidden');
          successContainer.classList.remove('hidden');
        } else {
          const resJson = await response.json();
          alert(resJson.message || 'Error');
          submitBtn.disabled = false;
          btnText.textContent = originalTextMap[document.documentElement.lang] || 'Send';
        }
      })
      .catch(() => {
        alert('Network error');
        submitBtn.disabled = false;
        btnText.textContent = originalTextMap[document.documentElement.lang] || 'Send';
      });
    });
  }

  // Słowniki pomocnicze do dynamicznej zmiany tekstu przycisku
  const langTextMap: Record<string, string> = {
    no: "Sender...",
    pl: "Wysyłanie...",
    en: "Sending...",
    uk: "Надсилання..."
  };

  const originalTextMap: Record<string, string> = {
    no: "Send melding",
    pl: "Wyślij wiadomość",
    en: "Send message",
    uk: "Надіслати повідомлення"
  };
</script>