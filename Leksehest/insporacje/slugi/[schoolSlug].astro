const t = translations[lang]?.[type] || translations.no.grunnskole;
const g = translations[lang]?.general || translations.no.general;

// Dynamiczny link do kontaktu dostosowany do reguł językowych (slugów)
const contactLink = lang === 'en' ? `/${lang}/contact/` : `/${lang}/kontakt/`;

// Wybór odpowiedniej zoptymalizowanej grafiki w zależności od typu strony
const activeImg = type === "grunnskole" ? squareHarmonyImg : fibonacciImg;
---

<BaseLayout title={t.title} description={t.desc} lang={lang} localizedUrls={localizedUrls}>
  <main class="bg-white text-slate-900 min-h-screen">
    
    <!-- SEKCJA HERO (Zoptymalizowana pod kątem CLS, A11y, Plain Language) -->
    <section class="relative bg-white pt-12 pb-8 md:pt-32 md:pb-24 border-b border-slate-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center">
          
        <div class="flex flex-col justify-center text-center lg:text-left lg:col-span-6 relative z-10">
                    <span class="text-xs md:text-sm font-bold tracking-widest uppercase text-[#0A192F] bg-white border border-[#0A192F] px-6 py-2.5 rounded-full w-fit mx-auto lg:mx-0 mb-4">
                    {t.badge}
                    </span>
            <!-- Usunięto niekontrastowy zielony kolor na rzecz granatu dla 100/100 Accessibility -->
            <h1 class="text-3xl font-extrabold tracking-tight text-[#173460] sm:text-5xl lg:text-6xl leading-tight uppercase">
              {t.heading1}<span class="text-[#173460]">{t.heading2}</span>
            </h1>
            <p class="mt-6 text-base text-slate-600 sm:text-lg leading-relaxed max-w-xl mx-auto lg:mx-0 font-medium">
              {t.intro}
            </p>
            <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
              <!-- NAPRAWIONY PRZYCISK #1 (Bezpieczna szerokość, wysokie paddingi, brak rozjeżdżania tekstu) -->
              <a 
                href={contactLink} 
                class="inline-flex items-center justify-center bg-[#173460] hover:bg-[#1f427a] text-white text-base sm:text-lg font-extrabold px-10 sm:px-14 py-5 rounded-2xl transition-all duration-200 shadow-xl tracking-wider uppercase w-full sm:w-auto min-w-[280px]"
              >
                {g.ctaBtn}
              </a>
            </div>
          </div>

          <!-- KONTENER NA GRAFIKĘ (Zabezpieczona wydajność LCP dzięki preloadingowi oraz formatowi WebP) -->
          <div class="relative lg:col-span-6 flex justify-center items-center select-none pointer-events-none">
            <Image 
              src={activeImg} 
              alt={t.imgAlt} 
              loading="eager"
              decoding="async"
              class="w-full max-w-[340px] sm:max-w-[420px] md:max-w-[460px] h-auto object-contain"
            />
          </div>

        </div>
      </div>
    </section>

    <!-- SEKCJA OFERTY SZCZEGÓŁOWEJ (Wysoki kontrast, czytelna struktura i18n) -->
    <section class="bg-slate-50 py-16 md:py-24 border-b border-slate-100">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
          
          <!-- Blok Przedmiotowy 1 -->
          <div class="bg-white border border-slate-200/60 rounded-[28px] p-8 shadow-sm hover:shadow-md transition-all flex flex-col gap-6">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 bg-[#173460]/10 text-[#173460] rounded-2xl flex items-center justify-center font-extrabold text-lg shrink-0">
                {t.subject1_badge}
              </div>
            <!-- Zamieniono h3 na h2 dla poprawnej struktury oraz zmieniono kolor nawiasu na czytelny granat -->
            <h2 class="text-xl sm:text-2xl font-extrabold text-[#173460] tracking-tight uppercase leading-snug">
                            {t.subject1_title.includes('(') ? (
                            <>
                                {t.subject1_title.split(' (')[0]}
                                <span class="block text-sm sm:text-base font-bold text-[#173460]/80 mt-0.5 normal-case">
                                ({t.subject1_title.split(' (')[1]}
                                </span>
                            </>
                            ) : (
                            t.subject1_title
                            )}
                        </h2>
            </div>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-normal">
              {t.subject1_desc}
            </p>
          </div>

          <!-- Blok Przedmiotowy 2 -->
          <div class="bg-white border border-slate-200/60 rounded-[28px] p-8 shadow-sm hover:shadow-md transition-all flex flex-col gap-6">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 bg-[#173460]/10 text-[#173460] rounded-2xl flex items-center justify-center font-extrabold text-lg shrink-0">
                {t.subject2_badge}
              </div>
              <!-- Zamieniono h3 na h2 dla poprawnej struktury nagłówków -->
              <h2 class="text-xl sm:text-2xl font-extrabold text-[#173460] tracking-tight uppercase leading-snug">
                {t.subject2_title}
              </h2>
            </div>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-normal">
              {t.subject2_desc}
            </p>
          </div>

          <!-- Blok Przedmiotowy 3 -->
          <div class="bg-white border border-slate-200/60 rounded-[28px] p-8 shadow-sm hover:shadow-md transition-all flex flex-col gap-6">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 bg-[#173460]/10 text-[#173460] rounded-2xl flex items-center justify-center font-extrabold text-lg shrink-0">
                {t.subject3_badge}
              </div>
              <!-- Zamieniono h3 na h2 dla poprawnej struktury nagłówków -->
              <h2 class="text-xl sm:text-2xl font-extrabold text-[#173460] tracking-tight uppercase leading-snug">
                {t.subject3_title}
              </h2>
            </div>
            <p class="text-slate-600 text-sm sm:text-base leading-relaxed font-normal">
              {t.subject3_desc}
            </p>
          </div>

        </div>
      </div>
    </section>

    <!-- SEKCJA WEZWANIA DO DZIAŁANIA (CTA) -->
    <section class="bg-white py-16 md:py-24">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="relative bg-[#173460] text-white rounded-[32px] p-8 md:p-16 text-center space-y-6 overflow-hidden shadow-xl">
          <div class="absolute w-24 h-24 bg-[#12ba87]/15 -top-6 -right-6 rounded-bl-[40px] pointer-events-none"></div>
          <div class="absolute w-24 h-24 bg-[#fd6847]/15 -bottom-6 -left-6 rounded-tr-[40px] pointer-events-none"></div>
          
          <h2 class="text-2xl md:text-4xl font-extrabold tracking-tight relative z-10 uppercase">
            {g.ctaHeading}
          </h2>
          <p class="text-slate-300 max-w-lg mx-auto text-base sm:text-lg relative z-10 leading-relaxed font-medium">
            {g.ctaDesc}
          </p>
          <div class="pt-4 relative z-10 flex justify-center">
            <!-- NAPRAWIONY PRZYCISK #2 (Wysokie paddingi, brak rozjeżdżania tekstu, stabilna pigułka) -->
            <a 
              href={contactLink} 
              class="inline-flex items-center justify-center bg-white hover:bg-slate-50 text-[#173460] font-extrabold text-base sm:text-lg px-10 sm:px-14 py-5 rounded-2xl transition-all duration-200 shadow-xl tracking-wider uppercase w-full sm:w-auto min-w-[280px]"
            >
              {g.ctaBtn}
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>