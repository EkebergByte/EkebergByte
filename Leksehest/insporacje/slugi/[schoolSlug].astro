    }
  },
  ua: {
    grunnskole: {
      title: "Початкова школа — Репетитор та Допомога з уроками | Leksehest",
      desc: "Індивідуальні заняття та допомога з домашніми завданнями з математики, природознавства та мов для учнів початкової школи в Норвегії.",
      badge: "1-10 класи",
      heading1: "Впевненість та ",
