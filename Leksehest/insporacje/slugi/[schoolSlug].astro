---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import squareHarmonyImg from '../../assets/square_harmony.webp';
import fibonacciImg from '../../assets/fibbonaci.webp';
export const prerender = false;
// Definiujemy dynamiczne ścieżki i lokalne slugi pod SEO dla każdego języka
export function getStaticPaths() {
  return [
    // Grunnskole / Szkoła podstawowa / Primary School / Початкова школа
    { params: { lang: "no", schoolSlug: "grunnskole" }, props: { type: "grunnskole" } },
    { params: { lang: "pl", schoolSlug: "szkola-podstawowa" }, props: { type: "grunnskole" } },
    { params: { lang: "en", schoolSlug: "primary-school" }, props: { type: "grunnskole" } },
    { params: { lang: "ua", schoolSlug: "pochatkova-shkola" }, props: { type: "grunnskole" } },

    // Videregående / Szkoła średnia / High School / Старша школа
    { params: { lang: "no", schoolSlug: "videregaende" }, props: { type: "videregaende" } },
    { params: { lang: "pl", schoolSlug: "szkola-srednia" }, props: { type: "videregaende" } },
    { params: { lang: "en", schoolSlug: "high-school" }, props: { type: "videregaende" } },
    { params: { lang: "ua", schoolSlug: "starsha-shkola" }, props: { type: "videregaende" } }
  ];
}

const { lang } = Astro.params;
const { type } = Astro.props;

// Dynamiczny słownik localizedUrls rozwiązujący błąd hreflang i przełącznika flag na podstronach
const localizedUrls = {
  no: type === "grunnskole" ? "/no/grunnskole/" : "/no/videregaende/",
  pl: type === "grunnskole" ? "/pl/szkola-podstawowa/" : "/pl/szkola-srednia/",
  en: type === "grunnskole" ? "/en/primary-school/" : "/en/high-school/",
  ua: type === "grunnskole" ? "/ua/pochatkova-shkola/" : "/ua/starsha-shkola/"
};

// Słownik tłumaczeń z silnymi, profesjonalnymi frazami dla wszystkich języków
